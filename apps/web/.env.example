# Dev: leave empty — Vite proxies /graphql → localhost:3000
# Prod / GitHub Pages: full URL to your VPS Nest GraphQL
#
#   VITE_GRAPHQL_URL=https://api.example.com/graphql
#   VITE_GRAPHQL_URL=http://YOUR_VPS_IP:3000/graphql
#
# Baked at build time (Vite). For Pages workflow set as Actions secret.
VITE_GRAPHQL_URL=
