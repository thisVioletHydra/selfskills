{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "unicorn"],
  "jsPlugins": ["../../packages/oxlint-rules/index.mjs"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/newline-after-import": "warn",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "selfskills/consistent-block-indent": "warn",
    "selfskills/consistent-chain-layout": "warn",
    "selfskills/consistent-parameter-layout": "warn",
    "selfskills/consistent-property-indent": "warn",
    "selfskills/consistent-ternary-layout": "warn",
    "selfskills/no-blank-lines-in-arrow-expression": "warn",
    "selfskills/no-blank-lines-in-chain": "warn",
    "selfskills/padding-line-before-decorator": "warn",
    "selfskills/prefer-process-import": "error",
    "no-negated-condition": "warn",
    "id-length": [
      "error",
      {
        "min": 2,
        "exceptions": ["i", "j", "f", "_"],
        "exceptionPatterns": ["^[A-Z]$"],
        "properties": "never"
      }
    ],
    "eqeqeq": ["error", "always"],
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableObject": false,
        "allowString": false,
        "allowNumber": false
      }
    ],
    "typescript/no-floating-promises": "error"
  }
}
