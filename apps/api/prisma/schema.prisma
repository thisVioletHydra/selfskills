generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id       String @id @default(cuid())
  slug     String @unique @default("main")
  name     String
  role     String
  tag      String
  blurb    String
  portrait String
  facts    Json
  goals    Json
  about    Json
}
