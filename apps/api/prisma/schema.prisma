generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id       String @id @default(cuid())
  slug     String @unique @default("main")
  name     String
  role     String
  tag      String
  blurb    String
  portrait String
  facts    Json
  about    Json
}

model ProfileLocale {
  id     String @id @default(cuid())
  locale String @unique
  name   String
  blurb  String
  facts  Json
  about  Json
}

model Resume {
  id              String @id @default(cuid())
  locale          String @unique
  phone           String
  email           String
  experienceYears String
  education       Json
  skills          Json
  jobs            Json
}
