# Пример конфига для apps/api.
# Скопируй и подставь свои значения:
#   cp .env.example .env
#
# Перед первым запуском подними Postgres:
#   pnpm db up          # из корня репо, см. infra/README.md
#
# После pull с новыми миграциями:
#   pnpm --filter api prisma migrate deploy
#   pnpm --filter api prisma:seed

# ---------------------------------------------------------------------------
# DATABASE_URL — строка подключения Prisma → PostgreSQL
# ---------------------------------------------------------------------------
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Дефолты совпадают с infra/docker-compose.yml (pnpm db up):
#   USER     = postgres
#   PASSWORD = postgres
#   HOST     = localhost   (контейнер проброшен на 5432)
#   PORT     = 5432
#   DATABASE = selfskills
#   SCHEMA   = public
#
# Другой хост/пароль — меняй только эту строку, код трогать не нужно.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selfskills?schema=public

# ---------------------------------------------------------------------------
# PORT — порт NestJS (Fastify), GraphQL: http://localhost:PORT/graphql
# ---------------------------------------------------------------------------
# Web в dev проксирует /graphql → http://localhost:3000 (см. apps/web/vite.config.ts).
# Если меняешь PORT здесь — обнови target в vite.config.ts или прокси сломается.
PORT=3000

# ---------------------------------------------------------------------------
# Prod / VPS — см. infra/VPS.md и infra/docker-compose.prod.yml
# ---------------------------------------------------------------------------
# DATABASE_URL на VPS указывает на сервис db внутри compose (host=db).
# Снаружи с ноута (seed через SSH tunnel):
#   ssh -L 5433:127.0.0.1:5432 user@vps
#   DATABASE_URL=postgresql://selfskills:PASS@localhost:5433/selfskills?schema=public
#   pnpm --filter api prisma:seed
