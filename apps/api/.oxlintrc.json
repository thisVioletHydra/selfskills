{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "unicorn"
  ],
  "jsPlugins": [
    "@selfskills/oxlint-rules"
  ],
  "rules": {
    "import/consistent-type-specifier-style": [
      "error",
      "prefer-top-level"
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-negated-condition": "warn",
    "unicorn/catch-error-name": "error",
    "selfskills/prefer-process-import": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/import-style": [
      "error",
      {
        "extendDefaultStyles": false,
        "checkDynamicImport": true,
        "checkRequire": true,
        "styles": {
          "node:assert": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:assert/strict": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:async_hooks": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:buffer": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:child_process": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:cluster": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:console": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:constants": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:crypto": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:dgram": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:diagnostics_channel": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:dns": {
            "default": true,
            "named": false,
            "namespace": false
          },
          "node:domain": {
            "default": true,
