# Copy: cp infra/.env.prod.example infra/.env.prod
# Never commit .env.prod

POSTGRES_USER=selfskills
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=selfskills

# Host port → container 3000. Put nginx/caddy in front if you have a domain.
API_HOST_PORT=3000
API_PORT=3000

# Comma-separated origins allowed by CORS. Empty = any origin.
CORS_ORIGIN=https://your-login.github.io
